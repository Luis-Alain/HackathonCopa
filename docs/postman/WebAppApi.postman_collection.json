      "name": "1. Contactos",
      "item": [
        {
          "name": "Crear contacto A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contacts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Postman\",\n  \"phone\": \"+50761234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set(\"contactAId\", c.id);",
                  "pm.test(\"Devuelve el contacto\", () => {",
                  "    pm.expect(c.name).to.eql(\"Ana Postman\");",
                  "    pm.expect(c.phone).to.eql(\"+50761234567\");",
                  "    pm.expect(c.id).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Header Location apunta al contacto\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(`/api/contacts/${c.id}`);",
                  "});"
                ]
              }
            }
          ]
        },
