    {
      "name": "2. Mensajes",
      "item": [
        {
          "name": "Enviar A → B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": {{contactAId}},\n  \"recipientId\": {{contactBId}},\n  \"content\": \"Hola Luis\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Forma de MessageResponse\", () => {",
                  "    const m = pm.response.json();",
                  "    pm.expect(m).to.have.all.keys(\"id\", \"senderId\", \"senderName\", \"recipientId\", \"recipientName\", \"content\", \"createdAt\", \"readAt\");",
                  "});",
                  "const m = pm.response.json();",
                  "pm.collectionVariables.set(\"messageId\", m.id);",
                  "pm.test(\"Emisor, receptor y nombres\", () => {",
                  "    pm.expect(m.senderId).to.eql(pm.collectionVariables.get(\"contactAId\"));",
                  "    pm.expect(m.recipientId).to.eql(pm.collectionVariables.get(\"contactBId\"));",
                  "    pm.expect(m.senderName).to.eql(\"Ana María Postman\");",
                  "    pm.expect(m.recipientName).to.eql(\"Luis Postman\");",
                  "});",
                  "pm.test(\"Sin leer\", () => pm.expect(m.readAt).to.be.null);",
                  "pm.test(\"Header Location apunta al mensaje\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(`/api/messages/${m.id}`);",
                  "});"
                ]
              }
            }
          ]
        },
